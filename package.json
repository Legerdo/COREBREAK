{
  "name": "corebreak",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "COREBREAK - 2D pixel art action-incremental drilling game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/balance-sim.ts",
    "smoke": "node tools/smoke.mjs",
    "qa": "node tools/qa.mjs",
    "endgame": "node tools/endgame.mjs",
    "playtest": "node tools/playtest.mjs"
  },
  "dependencies": {
    "galmuri": "2.40.3",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
